# Copy to .env and fill in. UPR_DATA_SOURCE=mock uses bundled sample data.
UPR_DATA_SOURCE=mock            # mock | file | live
UPR_FISCAL_YEAR=2025

# Overhead allocation: credit_hours | headcount | direct_cost
UPR_ALLOCATION_DRIVER=credit_hours

# Shared university operations pool to allocate (used by file mode; the
# dashboard can also set this interactively). Sample data supplies its own.
UPR_OPERATIONS_COST=

# --- File import (UPR_DATA_SOURCE=file) — the pre-API path ---
# One unified CSV/Excel...
UPR_IMPORT_FILE=
# ...or separate per-source exports that merge by program code:
UPR_JENZABAR_FILE=
UPR_NETSUITE_FILE=
UPR_SLATE_FILE=

# --- NetSuite Financials (ERP / GL) ---
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# --- Technolutions Slate (Admissions CRM) ---
SLATE_BASE_URL=
SLATE_QUERY_KEY=

# --- Jenzabar One (SIS) ---
JENZABAR_BASE_URL=
JENZABAR_API_KEY=
# or direct DB:
JENZABAR_DB_DSN=
